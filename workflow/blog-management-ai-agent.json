    {
      "parameters": {
        "jsCode": "let rawResponse = $input.first().json.choices[0].message.content;\n\n// Check if the JSON is truncated and try to gracefully close it if needed\nif (!rawResponse.trim().endsWith('}')) {\n  // If it cut off in the middle of the content string, close the string and the object\n  if (!rawResponse.trim().endsWith('\"')) {\n    rawResponse = rawResponse.trim() + '\"';\n  }\n  rawResponse = rawResponse + '\\n}';\n}\n\ntry {\n  const blog = JSON.parse(rawResponse);\n  \n  // Format escaped characters safely\n  if (blog.content) {\n    blog.content = blog.content\n      .replace(/\\\\n/g, '\\n')\n      .replace(/\\\\\"/g, '\"')\n      .replace(/\\\\\\\\/g, '\\\\');\n  }\n  \n  return [{ json: blog }];\n} catch (error) {\n  // Fallback if parsing still fails, so the workflow doesn't break entirely\n  return [{ \n    json: { \n      error: \"Failed to parse truncated JSON automatically.\", \n      rawText: rawResponse \n    } \n  }];\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1264,
        -720
      ],
      "id": "652d3a47-ea5b-48b5-80a8-38130c616357",
