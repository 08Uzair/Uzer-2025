    {
      "parameters": {
        "jsCode": "const response = $input.first().json.choices[0].message.content;\nlet cleaned = response.replace(/```json/g, \"\").replace(/```/g, \"\").trim();\n\n// If the JSON is cut off during an updateBlog action, manually reconstruct it safely\nif (cleaned.includes('\"action\": \"updateBlog\"') && !cleaned.endsWith('}')) {\n  \n  // 1. Extract the blogId securely\n  const blogIdMatch = cleaned.match(/\"blogId\"\\s*:\\s*\"([^\"]+)\"/);\n  const blogId = blogIdMatch ? blogIdMatch[1] : \"\";\n  // 2. Extract the title securely\n  const titleMatch = cleaned.match(/\"title\"\\s*:\\s*\"([^\"]+)\"/);\n  const title = titleMatch ? titleMatch[1] : \"\";\n  \n  // 3. Grab all available markup content generated so far\n  let content = \"\";\n  const contentMarker = '\"content\": \"';\n  const contentStartIdx = cleaned.indexOf(contentMarker);\n  \n  if (contentStartIdx !== -1) {\n    content = cleaned.substring(contentStartIdx + contentMarker.length);\n    \n    // Clean up any trailing hanging backslashes from a cut-off escape sequence (\\n or \\\")\n    if (content.endsWith('\\\\')) {\n      content = content.slice(0, -1);\n    }\n  }\n\n  // 4. Build the perfectly formatted output structure\n  const recoveredJson = {\n    action: \"updateBlog\",\n    blogId: blogId,\n    updatedBlogData: {\n      title: title,\n      content: content\n    }\n  };\n\n  return [{ json: recoveredJson }];\n}\n\n// Fallback: If the JSON is already fully complete or belongs to another action, parse normally\ntry {\n  const parsed = JSON.parse(cleaned);\n  return [{ json: parsed }];\n} catch (error) {\n  return [{ \n    json: { \n      error: \"JSON parsing failed entirely.\", \n      rawResponse: cleaned \n    } \n  }];\n}"
      },
