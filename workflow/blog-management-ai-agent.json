        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"openai/gpt-oss-120b\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are an expert blog writer. Generate complete blog articles in JSON format.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Create a professional blog based on the following topic:\\n\\n{{ $json.blogData.title }}\\n\\nUse the image provided: {{ $json.blogData.image || '' }}\\n\\nReturn ONLY a valid JSON object in this exact format:\\n{\\n  \\\"title\\\": \\\"\\\",\\n  \\\"image\\\": \\\"\\\",\\n  \\\"content\\\": \\\"\\\",\\n  \\\"author\\\": \\\"{{ $json.blogData.author || 'Admin' }}\\\",\\n  \\\"category\\\": \\\"\\\",\\n  \\\"createdAt\\\": \\\"\\\"\\n}\\n\\nRequirements:\\n- Generate an SEO-friendly title.\\n- Write a complete blog article of at least 800 words.\\n- Format the content using Markdown.\\n- Return ONLY valid JSON without markdown wrapping codeblocks.\"\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
